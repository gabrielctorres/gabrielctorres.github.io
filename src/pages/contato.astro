---
import Base from '../layouts/Base.astro';
import Icone from '../components/Icone.astro';
import { pt as t } from '../i18n/pt';

const atalhos = [
  { nome: 'GitHub', href: t.links.github, externo: true },
  { nome: 'LinkedIn', href: t.links.linkedin, externo: true },
  { nome: 'E-mail', href: `mailto:${t.email}`, externo: false },
];---
<Base titulo="Contato" secao="contato">
  <div class="contato">
    <section class="dialogo" aria-labelledby="contato-titulo">
      <h1 id="contato-titulo">Player 2 entrou?</h1>
      <p>Quer falar sobre uma vaga ou um projeto? Ou só sobre jogos? Me manda um e-mail.</p>
      <p class="rotulo">O botão abre o seu app de e-mail com a mensagem pronta.</p>

      <form class="formulario" data-formulario novalidate>
        <div class="campo">
          <label for="nome">Seu nome</label>
          <input id="nome" name="nome" type="text" autocomplete="name" required aria-describedby="nome-erro" />
          <p class="erro" id="nome-erro" aria-live="polite"></p>
        </div>
        <div class="campo">
          <label for="assunto">Assunto</label>
          <input id="assunto" name="assunto" type="text" placeholder="Vaga de programador Unity" />
        </div>
        <div class="campo">
          <label for="mensagem">Mensagem</label>
          <textarea id="mensagem" name="mensagem" rows="5" required aria-describedby="mensagem-erro"></textarea>
          <p class="erro" id="mensagem-erro" aria-live="polite"></p>
        </div>
        <button class="botao botao-primario" type="submit">
          <Icone nome="carta" tamanho={2} />
          Abrir no e-mail
        </button>
      </form>

      <div class="aviso" data-aviso hidden tabindex="-1">
        <strong>Mensagem pronta!</strong>
        <p>Seu app de e-mail deve abrir agora. Se ele não abrir copie o endereço e mande por onde preferir.</p>
        <button class="copiar" type="button" data-copiar={t.email}>
          <Icone nome="copiar" tamanho={2} />
          <span data-copiar-texto>Copiar {t.email}</span>
        </button>
      </div>
    </section>

    <aside class="atalhos" aria-labelledby="atalhos-titulo">
      <h2 class="titulo-secao" id="atalhos-titulo">Atalhos</h2>
      <ul>
        {atalhos.map((a) => (
          <li>
            <a class="atalho" href={a.href} {...(a.externo ? { target: '_blank', rel: 'noopener' } : {})}>
              {a.nome}
              <Icone nome={a.externo ? 'externo' : 'carta'} tamanho={2} />
            </a>
          </li>
        ))}
      </ul>
    </aside>
  </div>

  <Fragment slot="legenda">
    <span><kbd>Tab</kbd> {t.teclas.navegar}</span>
    <span><kbd>Enter</kbd> Enviar</span>
  </Fragment>
</Base>

<script>
  const EMAIL = 'gabrielctorres38@gmail.com';
  const form = document.querySelector<HTMLFormElement>('[data-formulario]')!;
  const aviso = document.querySelector<HTMLElement>('[data-aviso]')!;

  function validar(campo: HTMLInputElement | HTMLTextAreaElement, mensagem: string) {
    const erro = document.getElementById(`${campo.id}-erro`)!;
    const ok = campo.value.trim().length > 0;
    campo.setAttribute('aria-invalid', String(!ok));
    erro.textContent = ok ? '' : mensagem;
    return ok;
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const nome = form.elements.namedItem('nome') as HTMLInputElement;
    const assunto = form.elements.namedItem('assunto') as HTMLInputElement;
    const mensagem = form.elements.namedItem('mensagem') as HTMLTextAreaElement;
    const okMensagem = validar(mensagem, 'Escreva a mensagem antes de enviar.');
    const okNome = validar(nome, 'Diga seu nome para eu saber com quem estou falando.');
    if (!okNome) return nome.focus();
    if (!okMensagem) return mensagem.focus();

    const titulo = assunto.value.trim() || `Contato pelo portfólio: ${nome.value.trim()}`;
    const corpo = `${mensagem.value.trim()}\n\n${nome.value.trim()}`;
    location.href = `mailto:${EMAIL}?subject=${encodeURIComponent(titulo)}&body=${encodeURIComponent(corpo)}`;
    aviso.hidden = false;
    aviso.focus();
  });

  document.querySelectorAll<HTMLButtonElement>('[data-copiar]').forEach((b) => {
    b.addEventListener('click', async () => {
      const texto = b.querySelector('[data-copiar-texto]')!;
      try {
        await navigator.clipboard.writeText(b.dataset.copiar!);
        texto.textContent = 'Copiado!';
      } catch {
        texto.textContent = b.dataset.copiar!;
      }
    });
  });
</script>
